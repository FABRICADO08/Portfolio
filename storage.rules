rules_version = '2';

service firebase.storage {
  match /b/{bucket}/o {
    function isPortfolioOwner() {
      return request.auth != null
        && request.auth.token.email == 'anelefabricado@gmail.com';
    }

    match /portfolio/{contentType}/{itemId}/{fileName} {
      allow read: if true;
      allow create, update: if isPortfolioOwner()
        && request.resource.size < 5 * 1024 * 1024
        && request.resource.contentType.matches('image/.*');
      allow delete: if isPortfolioOwner();
    }
  }
}
